{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "rootDir": "../../",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist"
